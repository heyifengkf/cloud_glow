/* 云海页样式，配色沿用 app.wxss 的深色主题 */
.brand { display:flex; gap:10px; align-items:center; margin-bottom:8px; }
.title { font-size:16px; color:#c0d0e0; font-weight:700; }
.subtitle { font-size:12px; color:#667a90; }

.info { display:flex; flex-wrap:wrap; gap:6px; margin:4px 0 10px; }
.top-info { align-items:center; flex-wrap:nowrap; }
.location-pill {
  flex:1; min-width:0; display:flex; align-items:center; gap:4px;
  margin:0; overflow:hidden;
}
.location-name { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.source-switch {
  flex:none; display:flex; align-items:center; padding:3px;
  background:#0c1220; border:1px solid rgba(120,160,200,0.14); border-radius:999px;
}
.source-option {
  padding:5px 10px; border-radius:999px; font-size:11px;
  line-height:1.2; color:#667a90;
}
.source-option.active {
  color:#fff; font-weight:700;
  background:linear-gradient(135deg,#3a7bd5,#5b9bd5);
}

.elevation-line {
  font-size:12px; color:#667a90; margin-bottom:10px;
}
.elev-val { color:#aac8e0; font-weight:600; margin-left:4px; }

.state { margin:24px 0; text-align:center; color:#aac8e0; font-size:13px; }
.state.err { color:#e08a8a; }

.card {
  background:#0c1220; border-radius:12px; padding:14px;
  margin-bottom:12px; border:1px solid rgba(120,160,200,0.14);
}
.card.best { border-left:3px solid #f0a63c; }

.card-head { display:flex; align-items:center; gap:10px; }
.card-icon { font-size:22px; }
.card-title { flex:1; min-width:0; }
.ct-main { font-size:15px; color:#e6eef8; font-weight:700; }
.ct-sub { font-size:11px; color:#667a90; margin-top:2px; }
.badge {
  font-size:11px; color:#aac8e0; background:#111a2b;
  border-radius:999px; padding:4px 10px; white-space:nowrap;
}

.metrics { display:flex; gap:14px; margin:14px 0 6px; }
.metric { flex:1; min-width:0; }
.m-val { font-size:26px; font-weight:700; color:#e6eef8; line-height:1.1; }
.m-unit { font-size:13px; color:#667a90; margin-left:2px; }
.m-label { font-size:11px; color:#667a90; margin:3px 0 7px; }

.bar { height:5px; background:#111a2b; border-radius:999px; overflow:hidden; }
.bar-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,#3a7bd5,#5b9bd5); }
.card.best .bar-fill { background:linear-gradient(90deg,#8a5a1e,#f0a63c); }

.detail {
  display:flex; flex-wrap:wrap; margin-top:12px; padding-top:10px;
  border-top:1px solid rgba(120,160,200,0.10);
}
.d-row {
  width:50%; display:flex; justify-content:space-between;
  padding:3px 0; box-sizing:border-box;
}
.d-l { padding-right:12px; }
.d-r { padding-left:12px; }
.d-k { font-size:11px; color:#667a90; }
.d-v { font-size:11px; color:#aac8e0; }

.timeline { padding-bottom:10px; }
.tl-title { font-size:13px; color:#c0d0e0; font-weight:700; margin-bottom:10px; }
.tl-bars { display:flex; gap:3px; align-items:flex-end; height:90px; }
.tl-col { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; }
.tl-bar-track {
  width:100%; height:60px; display:flex; align-items:flex-end;
  background:#0a1020; border-radius:3px; overflow:hidden;
}
.tl-bar {
  width:100%; border-radius:3px 3px 0 0;
  background:linear-gradient(180deg,#5bc0d5,#2f7fb5);
}
.tl-h { font-size:8px; color:#667a90; margin-top:4px; transform:scale(0.9); transform-origin:center; white-space:nowrap; }

.data-note {
  font-size:10px; color:#556680; line-height:1.5;
  margin:6px 0; padding:6px 10px;
  background:#0c1220; border-radius:8px;
  border:1px solid rgba(120,160,200,0.14);
}

/* 海拔-云层高度剖面图 */
.alt-canvas { display:block; width:100%; background:#0a1020; border-radius:8px; }
.alt-legend { display:flex; gap:14px; align-items:center; margin-top:6px; }
.alt-legend-item { display:flex; align-items:center; gap:4px; font-size:10px; color:#667a90; }
.alt-dot { width:14px; height:3px; border-radius:2px; }
.alt-dot.el { background:#f0a63c; }
.alt-dot.cloud { background:#5bc0d5; }

/* 云层含量色阶图例（滑块叠加在渐变条上） */
.alt-scale { margin-top:8px; }
.alt-scale-title { font-size:10px; color:#667a90; }
.alt-scale-row { display:flex; align-items:center; gap:6px; margin-top:4px; }
.alt-scale-track { position:relative; flex:1; height:22px; }
.alt-scale-bar {
  position:absolute; left:0; right:0; top:50%; transform:translateY(-50%);
  height:8px; border-radius:4px;
  background:linear-gradient(90deg, rgba(232,240,250,0.08), rgba(232,240,250,0.82));
}
.alt-slider {
  position:absolute; left:-6px; right:-6px; top:50%; transform:translateY(-50%);
  margin:0;
}
.alt-scale-end { font-size:10px; color:#667a90; }
.alt-scale-hint { font-size:10px; color:#aac8e0; margin-top:2px; }
