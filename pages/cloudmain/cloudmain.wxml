<view class="app">
  <view class="brand">
    <view class="brand-icon">🌞</view>
    <view>
      <view class="title">云层剖面</view>
      <view class="subtitle">云层剖面数据预测</view>
    </view>
  </view>

  <view class="search-box">
    <view class="loc-field" bindtap="onPickLocation">
      <text class="loc-name">{{locName}}</text>
      <text class="loc-hint">{{locating ? '定位中…' : '点击更换地点'}}</text>
    </view>
    <button class="btn locate-btn" bindtap="onRelocate" aria-label="定位当前位置">
      <view class="locate-mark">
        <view class="locate-center"></view>
      </view>
    </button>
  </view>

  <view class="source-row">
    <view class="src-toggle">
      <view class="src-seg {{dataSource === 'ec' ? 'active' : ''}}" data-src="ec" bindtap="onSwitchSource">ECMWF</view>
      <view class="src-seg {{dataSource === 'gfs' ? 'active' : ''}}" data-src="gfs" bindtap="onSwitchSource">GFS</view>
      <view class="src-seg {{dataSource === 'icon' ? 'active' : ''}}" data-src="icon" bindtap="onSwitchSource">ICON</view>
    </view>
    <view class="range-inline"><text>🕒</text><text>{{infoRange}}</text></view>
  </view>

  <view class="chart-wrap">
    <canvas type="2d" id="mainCanvas" class="main-canvas" style="width:100%;height:{{canvasH}}px"
      bindtouchstart="onCanvasTouchStart" bindtouchmove="onCanvasTouchMove" bindtouchend="onCanvasTouchEnd" bindtouchcancel="onCanvasTouchEnd"></canvas>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
  </view>

  <view class="cloud-legend">
    <view class="legend-item">
      <view class="legend-dot low"></view>
      <text class="legend-name">低云</text>
      <text class="legend-alt">0–2km</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot mid"></view>
      <text class="legend-name">中云</text>
      <text class="legend-alt">2–7km</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot high"></view>
      <text class="legend-name">高云</text>
      <text class="legend-alt">5–10km</text>
    </view>
  </view>
  <view class="legend-note">剖面按低/中/高三档等分高度渲染（0–2 / 2–5 / 5–10km），5km 以上统一归入高云区</view>

  <view class="data-note">
    <view class="data-note-item">能见度：Open-Meteo 最佳匹配源（不随模型切换）</view>
    <view class="data-note-item">气溶胶：Open-Meteo 空气质量接口 · CAMS（不随模型切换）</view>
  </view>

  <!-- <view class="footer">数据来自 Open-Meteo · Copyright © Yifeng </view> -->
  <view class="footer">Copyright © Yifeng </view>
</view>
